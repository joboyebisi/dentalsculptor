# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
UI_PREVIEW_MODE=false
NEXT_PUBLIC_UI_PREVIEW_MODE=false
# Hide Microsoft sign-in for pilot (org accounts often need IT admin consent). Set true when Azure is fully verified.
NEXT_PUBLIC_ENABLE_MICROSOFT_AUTH=false
RESEARCH_GENERATION_ACCESS_CODE=
# Educator invite URL: https://YOUR_APP/?invite=<same value as above>
# Optional: Google Search Console HTML tag (content value only) for site verification
GOOGLE_SITE_VERIFICATION=

# Supabase Auth + database + storage (single project)
# DATABASE_URL — Postgres connection for Prisma (server-side only).
#
# For Vercel / serverless, use the Supabase **Transaction pooler** on port **6543**:
#   Supabase Dashboard → Project Settings → Database → Connection string
#   → choose "Transaction pooler" → URI → copy the string (ends with :6543/...?pgbouncer=true)
#
# Why 6543? Vercel functions open many short-lived connections. The pooler multiplexes
# them so you do not hit Postgres connection limits. Port 5432 (session/direct) is fine
# for local `npm run dev` and one-off migrations from your machine.
#
# Same Supabase project for both local and Vercel — you do NOT need a fresh database.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=dentalsculptor-assets

# ML provider
ML_MESH_PROVIDER=modal
ML_ALLOW_FAL_FALLBACK=false
MODAL_GENERATE_URL=https://dentalsculptor--generate.modal.run
MODAL_GENERATE_ASYNC_URL=https://dentalsculptor--generate-job.modal.run
MODAL_FINALIZE_ASYNC_URL=https://dentalsculptor--finalize-job.modal.run
MODAL_EDIT_URL=https://dentalsculptor--edit.modal.run
MODAL_INPAINT_URL=https://dentalsculptor--inpaint.modal.run
MODAL_JOB_STATUS_URL=https://dentalsculptor--job-status.modal.run
MODAL_WARM_GPU_URL=https://dentalsculptor--warm-gpu.modal.run
MODAL_WEBHOOK_SECRET=
MODAL_ASYNC_S3_ENABLED=true
FAL_KEY=

# Hybrid large-asset storage (planned production path)
STORAGE_BACKEND=supabase
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=

# Modal deployment settings (read by `python -m modal deploy`)
TRELLIS_DEPLOYMENT_ENV=development
TRELLIS_MODAL_GPU=A100
TRELLIS_MIN_CONTAINERS=0
TRELLIS_RESEARCH_WARM_POOL=false
TRELLIS_BUFFER_CONTAINERS=0
TRELLIS_SCALEDOWN_WINDOW=1200
TRELLIS_MAX_CONTAINERS=1
TRELLIS_ENABLE_TF32=true
TRELLIS_ENABLE_WARMUP=false
TRELLIS_HF_HUB_OFFLINE=false
TRELLIS_ASYNC_S3_ENABLED=true
TRELLIS_BASE64_COMPAT_ENABLED=true

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# =============================================================================
# DentalSculptor — environment template
# Copy this file to `.env` and fill in REAL values in `.env` only.
# Never commit `.env` — it is gitignored.
# See ../docs/ENV.md and ../docs/SUPABASE_SETUP.md
# =============================================================================

# --- Preview mode (local UI testing without auth/DB) ---
# Set both to `true` to browse all pages without login. Use `false` for production.
UI_PREVIEW_MODE=false
NEXT_PUBLIC_UI_PREVIEW_MODE=false

# --- Supabase Auth + database + storage ---
# Authentication → URL Configuration: Site URL = production app URL
# Redirect URLs: /auth/callback and /consent for prod + localhost
# Authentication → Providers: Email (disable confirm for pilot); OAuth as needed
# Dashboard: https://supabase.com/dashboard → your project → Settings

# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co

# Anon public key (Settings → API → anon public) — used by Supabase Auth in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (Settings → API → service_role) — SERVER ONLY, never NEXT_PUBLIC_
# Used for server-side uploads to Storage
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Storage bucket name (create in Storage → New bucket → see SUPABASE_SETUP.md)
SUPABASE_STORAGE_BUCKET=dentalsculptor-assets

# PostgreSQL — Settings → Database → Connection string
# Direct (paste from Supabase URI tab — no [brackets], encode # as %23):
DATABASE_URL=postgresql://postgres:[YOUR_DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Session pooler (if direct db.* unreachable on your network — copy from Supabase dashboard):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres

# Transaction pooler (Vercel production, port 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# --- fal.ai — interim 3D generation (until Modal TRELLIS is live) ---
FAL_KEY=
ML_MESH_PROVIDER=fal

# --- Modal.com — TRELLIS + Nano3D (see ../docs/MODAL_SETUP_GUIDE.md) ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_GENERATE_URL=
MODAL_EDIT_URL=
MODAL_JOB_STATUS_URL=
MODAL_WEBHOOK_SECRET=

# --- AWS S3 — mesh/job storage (recommended with AWS credits) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=dentalsculptor-assets-prod

# Generation speed vs quality (server-side only):
# Default: PBR textured OBJ/GLB (~30–90s). Best visual quality for teaching.
# FAL_ENABLE_PBR=false          # skip PBR pass (slightly faster, lower quality)
# FAL_ENABLE_GEOMETRY=true      # geometry-only white GLB (~faster, no textures) — good for quick previews

# --- Application URL (required for Clerk redirects in production) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- PostHog Analytics (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

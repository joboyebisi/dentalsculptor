# DentalSculptor — root .gitignore

# Dependencies
node_modules/
.pnp
.pnp.*

# Next.js
.next/
out/
build/

# Environment & secrets
.env
.env.*
!.env.example

# OS & IDE
.DS_Store
Thumbs.db
*.pem
.vercel
.cursor/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo

# Prisma generated (regenerated on install)
dentalsculptor-app/src/generated/

# Large ML weights (never commit)
*.zip
**/Resources/ML/
**/weights/

# Optional: exclude build artifacts from bloom if not needed
bloom-v0/.next/
bloom-v0/node_modules/

# Keep design specs but ignore large binary exports if any
*.blend1
